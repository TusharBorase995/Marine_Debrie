# ==============================================================================
# PS 26057 Hydrographic Operations — Database Environment Configuration
# ==============================================================================

# Primary PostgreSQL Database Connection (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@[ENDPOINT].c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:[PASSWORD]@[ENDPOINT-UNPOOLED].c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production

# Neon Object Storage (S3-compatible, private sagar-images bucket)
AWS_ACCESS_KEY_ID=your-neon-storage-access-key-id
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-access-key
AWS_ENDPOINT_URL_S3=https://[BRANCH-STORAGE-ENDPOINT].storage.c-5.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
NEON_OBJECT_STORAGE_BUCKET=sagar-images

# Server Configuration
PORT=8000
HOST=127.0.0.1
