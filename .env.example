# ==============================================================================
# PS 26057 Hydrographic Operations — Database Environment Configuration
# ==============================================================================

# By default, the system runs with local high-performance SQLite (no setup needed).
# To connect to a cloud or local PostgreSQL database, uncomment and provide DATABASE_URL:

# 1. Neon.tech (Free Serverless PostgreSQL - Recommended)
# DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/sonar_db?sslmode=require

# 2. Supabase (Free Managed PostgreSQL with PostGIS)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# 3. Render.com (Free Managed PostgreSQL)
# DATABASE_URL=postgresql://sonar_user:password@dpg-xxxx.render.com/sonar_db

# 4. Local PostgreSQL (Docker or Desktop install)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sonar_db

# Optional Server Port Configuration
PORT=8000
HOST=127.0.0.1
